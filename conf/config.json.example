{
    "generator": {
        "deepseek": {
            "api_key": "<DEEPSEEK API KEY>",
            "base_url": "https://api.deepseek.com",
            "model": "deepseek-v4-pro",
            "evaluator_model": "deepseek-flash",
            "thinking": true,
            "evaluator_thinking": false,
            "temperature": 0.9,
            "max_tokens": 500
        }
    },
    "timezone": "America/Los_Angeles",
    "irc": {
        "host": "irc.lurker.chat",
        "port": 6697,
        "tls": true,
        "max_line_length": 340,
        "typing_notifications": {
            "enabled": true,
            "refresh_seconds": 3
        }
    },
    "autonomous": {
        "enabled": true,
        "debounce_seconds": 20,
        "max_wait_seconds": 60,
        "address_wait_seconds": 5,
        "cooldown_messages": 3,
        "cooldown_seconds": 45,
        "reply_window_seconds": 180,
        "max_bot_ratio": 0.4,
        "ratio_window": 10,
        "max_context_age_minutes": 30,
        "max_conversation_gap_minutes": 30
    },
    "journal": {
        "enabled": true,
        "messages_per_pass": 40,
        "quiet_minutes": 20,
        "min_messages": 5,
        "max_messages_per_pass": 200,
        "journal_max_chars": 1500,
        "note_max_chars": 600,
        "model": "deepseek-flash"
    },
    "bots": [
        {
            "id": "isaac",
            "nick": "isaac",
            "realname": "Isaac the Robot",
            "persona": "conf/personas/isaac.md",
            "account": {
                "name": "isaac",
                "password": "<NickServ password for this bot's account>"
            },
            "channels": ["#lurker"],
            "pm_allowed_users": [],
            "generator": { "temperature": 0.9 },
            "autonomous": { "cooldown_seconds": 45 }
        }
    ],
    "vision": {
        "enabled": false,
        "supported_formats": ["png", "jpg", "jpeg", "gif", "webp"],
        "max_file_size_mb": 20
    },
    "openai": {
        "api_key": "<OPENAI API KEY>",
        "model": "gpt-4o",
        "max_tokens": 300
    },
    "web": {
        "enabled": true,
        "port": 3000,
        "auth": {
            "username": "admin",
            "password": "<DASHBOARD_PASSWORD>"
        }
    },
    "kagi": {
        "api_key": "<KAGI API KEY (optional, for web search and URL summarization)>"
    },
    "url_summarize": {
        "enabled": true,
        "summary_type": "takeaway",
        "max_urls_per_message": 3,
        "timeout": 120000
    }
}
