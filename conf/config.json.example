{
    "generator": {
        "deepseek": {
            "api_key": "<DEEPSEEK API KEY>",
            "base_url": "https://api.deepseek.com",
            "model": "deepseek-v4-pro",
            "evaluator_model": "deepseek-flash",
            "thinking": true,
            "evaluator_thinking": false,
            "temperature": 0.9,
            "frequency_penalty": 0.3,
            "presence_penalty": 0,
            "max_tokens": 500,
            "timeout_seconds": 300,
            "max_retries": 1
        }
    },
    "timezone": "America/Los_Angeles",
    "irc": {
        "host": "irc.lurker.chat",
        "port": 6697,
        "tls": true,
        "max_line_length": 340,
        "multiline": true,
        "reactions": true,
        "reaction_max_length": 24,
        "reply_min_distance": 5,
        "bot_nicks": [],
        "dm_delay_min_seconds": 2,
        "dm_delay_max_seconds": 6,
        "typing_notifications": {
            "enabled": true,
            "refresh_seconds": 3,
            "max_seconds": 300
        }
    },
    "autonomous": {
        "enabled": true,
        "debounce_seconds": 20,
        "max_wait_seconds": 60,
        "address_wait_seconds": 5,
        "react_cooldown_messages": 3,
        "react_cooldown_seconds": 30,
        "prompt_retention_days": 30
    },
    "context": {
        "screen_lines": 50,
        "screen_step": 10,
        "max_lines": 150,
        "lull_minutes": 30,
        "max_link_summaries": 5,
        "tic_lines": 30,
        "calendar_horizon_days": 7
    },
    "weather_cache_minutes": 60,
    "presence": {
        "enabled": true,
        "afk_minutes": 15,
        "afk_message": "afk since {time}",
        "linger_minutes": 15,
        "goodbye_window_minutes": 10
    },
    "spontaneous": {
        "enabled": true,
        "quiet_min_minutes": 15,
        "quiet_max_minutes": 45,
        "channel_gap_minutes": 30,
        "typing_wait_seconds": 30,
        "max_per_day": 2,
        "min_gap_minutes": 60,
        "weight": 1,
        "address_chance": 0,
        "seeds_per_day": 3,
        "happenings_per_day": 1,
        "spent_days": 3,
        "news": true,
        "news_chance": 0.35,
        "news_cache_minutes": 360,
        "return_delay_min_minutes": 1,
        "return_delay_max_minutes": 5,
        "return_quiet_minutes": 5
    },
    "journal": {
        "enabled": true,
        "messages_per_pass": 40,
        "quiet_minutes": 20,
        "min_messages": 5,
        "max_messages_per_pass": 200,
        "journal_max_chars": 1500,
        "note_max_chars": 600,
        "model": "deepseek-flash"
    },
    "bots": [
